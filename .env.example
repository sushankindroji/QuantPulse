# QuantPulse environment variables (copy to .env for local overrides)
# Nothing here is a secret required for demo mode — Docker Compose already
# provides sensible defaults for everything below.

# --- Backend ---
QP_EXPERIMENTS_DB=experiments/experiments.db
QP_DATASETS_DB=experiments/datasets.db
DATABASE_URL=postgresql://quantpulse:quantpulse@postgres:5432/quantpulse
QP_DATA_MODE=demo

# Storage backend for uploaded datasets: "local" for development (default),
# "s3" for production once an S3-compatible backend is implemented in
# app/data/storage.py (Render's filesystem is ephemeral, so production
# deployments should not rely on QP_STORAGE_BACKEND=local).
QP_STORAGE_BACKEND=local

# Only needed if/when QP_STORAGE_BACKEND=s3 is implemented:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
